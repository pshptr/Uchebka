struct FILO *create(struct FILO *head, int x) \{\
	struct FILO *n;    //    \
	n = (struct FILO *)malloc(sizeof(struct FILO)); //  \
	n->next = NULL;\
	n->data = x;\
	if (head == NULL)\
		head = n;\
	else\
	\{\
		n->next = head;\
		head = n;\
	\}\
	return head;\
\}\
\
\
void print(struct FILO *head)\{\
	struct FILO *p = head;\
	while (p != NULL) \{   //        \
		printf("%2d ---> ", p->data);\
		p = p->next;       //   \
	\}\
	printf("\\n");\
\}\
}