#include <stdio.h>\
#include <stdlib.h>\
/*       N. \
  . */\
\
struct FILO \{\
	int data;\
	struct FILO *next;\
\};\
\
struct FILO *create(struct FILO *, int);  //    ,   \
void print(struct FILO *); //  \
\
int main() \{\
	int i, n;\
	struct FILO *head;    // ,    \
	head = NULL;\
\
	scanf("%d", &n);\
	for (i = 1; i <= n; i++) \{\
		head = create(head, i);\
		printf("%2d <--- ", head->data);\
	\}\
	printf("\\n");\
	print(head);\
	free(head);\
\}\
\
